{
  "expo": {
    "name": "FruitTrace",
    "slug": "fruit-batch-management-system",
    "version": "1.0.0",
    "scheme": "fruittrace",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14532D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fruittrace.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a6cec5c6-3a0b-4ed0-90f3-0c287053113c"
      }
    },
    "owner": "liam0412s-team",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ứng dụng cần camera để chụp ảnh lô hàng và quét mã QR"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 220,
          "backgroundColor": "#14532D",
          "resizeMode": "contain"
        }
      ],
      "react-native-fast-tflite"
    ]
  }
}
